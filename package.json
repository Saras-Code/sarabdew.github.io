{
  "name": "sara-magazine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "check:copy": "tsx scripts/check-copy.ts",
    "verify": "tsx scripts/verify.ts",
    "check:links": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "page-flip": "2.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.0",
    "playwright": "1.52.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
